# SMTP server used to email contact-form enquiries.
SMTP_HOST=smtp.example.com
# 465 uses implicit TLS; 587 (default) upgrades with STARTTLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender address. Most providers require this to be the SMTP account or a verified alias.
# Defaults to SMTP_USER.
MAIL_FROM=
# Where enquiries are delivered. Defaults to the sales address in lib/site.ts.
MAIL_TO=
